# Local development defaults. Copy to `.env` and adjust secrets before shared use.
APP_APP_NAME="Biologic System Backend API"
APP_API_V1_PREFIX="/api/v1"
APP_DEBUG=false
APP_IS_DEV=true
APP_DOCS_URL="/docs"
APP_OPENAPI_URL="/openapi.json"

# PostgreSQL 15 from docker-compose.yml.
APP_DATABASE_URL="postgresql+asyncpg://biologic:biologic@127.0.0.1:5434/biologic"

# Where full-database dumps are written. Defaults to /var/lib/biologic/backups
# (ProgramData\biologic\backups on Windows) — a system data directory, kept
# outside the project checkout so dumps survive a redeploy or clean clone.
# Override for local dev if that path isn't writable by your user, e.g.:
# APP_DATABASE_BACKUP_DIR="$HOME/.local/share/biologic/backups"

APP_JWT_SECRET_KEY="change-me-local-jwt-secret"
APP_JWT_ALGORITHM="HS256"
APP_ACCESS_TOKEN_TTL_SECONDS=1800
APP_REFRESH_TOKEN_TTL_SECONDS=86400
APP_REFRESH_TOKEN_REMEMBER_TTL_SECONDS=2592000
APP_ACCESS_COOKIE_NAME="access_cookie"
APP_REFRESH_COOKIE_NAME="refresh_cookie"
APP_AUTH_COOKIE_SAMESITE="lax"
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_DOMAIN="localhost"
APP_AUTH_COOKIE_PATH="/"
